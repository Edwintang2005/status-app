<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Local mode only. No iCloud and no APNs: both need a paid team, and
	     neither is used when TETHER_LOCAL_MODE is compiled in. The App Group
	     is all the widget needs, and the Simulator grants it without a
	     provisioning profile. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.edwintang.tether</string>
	</array>
</dict>
</plist>
