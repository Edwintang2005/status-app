<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- development APNs. The Release build uses the production file; see project.yml. -->
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.edwintang.tether</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
		<!-- CloudDocuments is only for the memories archive: it writes a
		     folder of ordinary files into iCloud Drive so someone can keep
		     what they were sent after unlinking. Nothing else uses it. -->
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.com.edwintang.tether</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.edwintang.tether</string>
	</array>
</dict>
</plist>
